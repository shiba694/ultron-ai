# ================================================================
# Ultron AI — Production & Local Environment Variables
# ================================================================
# NEVER commit .env to Git! (.env is in .gitignore)
#
# LOCAL DEV:
#   Optional. Default values run out-of-the-box with docker-compose.yml.
#
# GCP PRODUCTION DEPLOYMENT:
#   On your GCP VM, copy this template to .env and customize:
#   cp .env.example .env
#   chmod 600 .env
# ================================================================

# --- Database & Storage Secrets ---
POSTGRES_DB=ultron
POSTGRES_USER=ultron
POSTGRES_PASSWORD=ultron123

# --- API Security ---
ULTRON_API_KEY=ultron-default-api-key

# --- AI / LLM Configuration ---
# Options: vertex (Recommended for GCP) | openrouter | ollama
LLM_PROVIDER=vertex
GCP_PROJECT_ID=ultron-ai-cloud
GCP_LOCATION=asia-south1
VERTEX_MODEL=gemini-3.8-flash
# Optional: GEMINI_API_KEY (for local development without gcloud ADC)
GEMINI_API_KEY=

# Optional Cloud Fallback: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# --- Google Cloud Firestore Real-time Sync ---
FIRESTORE_ENABLED=true
FIRESTORE_DATABASE=(default)

# --- Frontend Target (Used when building React SPA) ---
# For local dev: http://localhost:8084/api/v1
# For GCP production: http://<YOUR_GCP_VM_STATIC_IP>/api/v1
VITE_API_BASE_URL=http://localhost:8084/api/v1

# --- Optional Firebase Web App (For React UI Real-time WebSocket Streaming) ---
# Obtain from Firebase Console > Project Settings > Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=ultron-ai-cloud
VITE_FIREBASE_AUTH_DOMAIN=ultron-ai-cloud.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=ultron-ai-cloud.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
